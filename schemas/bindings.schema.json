{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profilemango.dev/schemas/bindings-v1alpha1.json",
  "title": "Local route bindings v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "model", "effort"],
        "properties": {
          "provider": {"$ref": "#/$defs/field"},
          "transport": {"$ref": "#/$defs/field", "default": "native"},
          "authentication": {"$ref": "#/$defs/field", "default": "oauth"},
          "model": {"$ref": "#/$defs/field"},
          "effort": {"$ref": "#/$defs/field"},
          "targets": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"enum": ["claude-code", "codex", "hermes", "jcode-fork", "oh-my-pi", "openclaw", "opencode", "pi"]},
            "additionalProperties": {"$ref": "#/$defs/targetOverride"}
          },
          "roles": {"$ref": "#/$defs/roles"}
        }
      }
    }
  },
  "$defs": {
    "field": {"type": "string", "minLength": 1},
    "effectiveRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "transport", "authentication", "model", "effort"],
      "properties": {
        "provider": {"$ref": "#/$defs/field"},
        "transport": {"$ref": "#/$defs/field"},
        "authentication": {"$ref": "#/$defs/field"},
        "model": {"$ref": "#/$defs/field"},
        "effort": {"$ref": "#/$defs/field"},
        "roles": {"$ref": "#/$defs/roles"}
      }
    },
    "roles": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$", "not": {"const": "default"}},
      "additionalProperties": {"$ref": "#/$defs/roleRoute"}
    },
    "roleRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"$ref": "#/$defs/field"},
        "model": {"$ref": "#/$defs/field"},
        "effort": {"$ref": "#/$defs/field"}
      }
    },
    "targetOverride": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "provider": {"$ref": "#/$defs/field"},
        "transport": {"$ref": "#/$defs/field"},
        "authentication": {"$ref": "#/$defs/field"},
        "model": {"$ref": "#/$defs/field"},
        "effort": {"$ref": "#/$defs/field"}
      }
    }
  }
}
