{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profilemango.dev/schemas/render-v1alpha1.json",
  "title": "RenderReport v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "profile",
    "target",
    "targetVersion",
    "adapterVersion",
    "applicable",
    "preview",
    "evidence",
    "capabilities",
    "diagnostics",
    "artifacts"
  ],
  "properties": {
    "apiVersion": {"const": "profilemango.dev/render/v1alpha1"},
    "kind": {"const": "RenderReport"},
    "profile": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "targetVersion": {"type": "string", "minLength": 1},
    "adapterVersion": {"type": "string", "minLength": 1},
    "applicable": {"type": "boolean"},
    "preview": {"type": "boolean"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "version", "sha256", "source", "level"],
      "properties": {
        "target": {"const": "codex"},
        "version": {"const": "0.154.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "level": {"type": "string", "minLength": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "status", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "status": {"enum": ["supported", "partial", "unverified", "blocking"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["error", "warning"]},
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "message": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 0},
        "column": {"type": "integer", "minimum": 0}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "size"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["candidate-config", "resource"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    }
  }
}
