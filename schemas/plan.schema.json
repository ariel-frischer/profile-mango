{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profilemango.dev/schemas/plan-v1alpha1.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "profile", "target", "route", "resources"],
  "properties": {
    "apiVersion": {"const": "profilemango.dev/plan/v1alpha1"},
    "kind": {"const": "Plan"},
    "profile": {"type": "string"}, "target": {"type": "string"},
    "route": {"$ref": "bindings.schema.json#/$defs/effectiveRoute"},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}}
  },
  "$defs": {"resource": {"type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256", "size"], "properties": {"path": {"type": "string"}, "kind": {"enum": ["instruction", "skill"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}}
}
