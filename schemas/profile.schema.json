{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profilemango.dev/schemas/policy-profile-v1alpha1.json",
  "title": "PolicyProfile v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "profilemango.dev/v1alpha1"},
    "kind": {"const": "PolicyProfile"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "extends": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "routeRef": {"type": "string", "minLength": 1},
        "permissions": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["read-only", "workspace-write", "unrestricted"]},
            "network": {"enum": ["allow", "deny", "unmanaged"]},
            "shell": {"enum": ["allow", "deny", "unmanaged"]}
          }
        },
        "tools": {"$ref": "#/$defs/accessRules"},
        "instructions": {
          "type": "object", "additionalProperties": false,
          "properties": {"append": {"type": "array", "items": {"type": "string"}}}
        },
        "skills": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "accessRules": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
