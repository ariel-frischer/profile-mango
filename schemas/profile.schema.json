{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profilemango.dev/schemas/policy-profile-v1alpha1.json",
  "title": "PolicyProfile v1alpha1",
  "description": "A flat profile document. name is optional and defaults to the profile folder name; when present it must match. The apiVersion/kind/metadata/spec wrapper is deprecated but still accepted.",
  "oneOf": [
    {"$ref": "#/$defs/flatProfile"},
    {"$ref": "#/$defs/legacyProfile"}
  ],
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "flatProfile": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"type": "string"},
        "labels": {"$ref": "#/$defs/labels"},
        "extends": {"$ref": "#/$defs/name"},
        "route": {"type": "string", "minLength": 1},
        "permissions": {"$ref": "#/$defs/permissions"},
        "tools": {"$ref": "#/$defs/accessRules"},
        "instructions": {"$ref": "#/$defs/instructions"},
        "skills": {"$ref": "#/$defs/paths"},
        "globalInstructions": {"$ref": "#/$defs/globalInstructions"},
        "roles": {"$ref": "#/$defs/roles"}
      }
    },
    "legacyProfile": {
      "deprecated": true,
      "description": "Deprecated wrapped form; parsed with a profile.legacy_format warning.",
      "type": "object", "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": {"const": "profilemango.dev/v1alpha1"},
        "kind": {"const": "PolicyProfile"},
        "metadata": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/name"},
            "description": {"type": "string"},
            "labels": {"$ref": "#/$defs/labels"}
          }
        },
        "spec": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "extends": {"$ref": "#/$defs/name"},
            "routeRef": {"type": "string", "minLength": 1},
            "permissions": {"$ref": "#/$defs/permissions"},
            "tools": {"$ref": "#/$defs/accessRules"},
            "instructions": {"$ref": "#/$defs/instructions"},
            "skills": {"$ref": "#/$defs/paths"},
            "globalInstructions": {"$ref": "#/$defs/globalInstructions"}
          }
        }
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["read-only", "workspace-write", "unrestricted"]},
        "network": {"enum": ["allow", "deny", "unmanaged"]},
        "shell": {"enum": ["allow", "deny", "unmanaged"]}
      }
    },
    "instructions": {
      "type": "object", "additionalProperties": false,
      "properties": {"append": {"$ref": "#/$defs/paths"}}
    },
    "globalInstructions": {
      "description": "Whole global instruction files per target, or under the target-neutral home key for files in the user's home directory (home: {AGENTS.md: ...} writes ~/AGENTS.md): file name to resource path beneath the package root. Only files with pinned evidence install; others are skipped or blocked.",
      "type": "object",
      "propertyNames": {"enum": ["home", "claude-code", "codex", "hermes", "jcode-fork", "oh-my-pi", "openclaw", "opencode", "pi"]},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.md$"},
        "additionalProperties": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "description": "Portable role definitions. Models for each role come from bindings routes.<name>.roles; no qualified target installs these descriptions or instructions yet.",
      "type": "object", "minProperties": 1,
      "propertyNames": {"enum": ["worker", "planner", "research", "tiny"]},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "instructions": {"type": "string", "minLength": 1, "description": "Resource path beneath the package root."}
        }
      }
    },
    "paths": {"type": "array", "items": {"type": "string"}},
    "accessRules": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allow": {"$ref": "#/$defs/paths"},
        "deny": {"$ref": "#/$defs/paths"}
      }
    }
  }
}
