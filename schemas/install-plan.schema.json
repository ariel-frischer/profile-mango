{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://profilemango.dev/schemas/install-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "planID", "profile", "status", "backup", "override", "inputSHA256", "targets"],
  "properties": {
    "apiVersion": {"const": "profilemango.dev/install-plan/v1alpha1"},
    "kind": {"const": "InstallPlan"},
    "planID": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"type": "string"},
    "status": {"enum": ["ready", "noop", "blocked"]},
    "backup": {"type": "boolean"},
    "override": {"type": "boolean"},
    "strict": {"type": "boolean"},
    "inputSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/targetPlan"}},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "version", "adapterVersion", "installable", "status", "reason"],
      "properties": {
        "target": {"type": "string"},
        "version": {"type": "string"},
        "adapterVersion": {"type": "string"},
        "evidenceSHA256": {"type": "string"},
        "compatibleRange": {"type": "string"},
        "installable": {"type": "boolean"},
        "status": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string"},
        "before": {"type": "string"},
        "after": {"type": "string"},
        "sensitive": {"type": "boolean"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "owned"],
      "properties": {
        "path": {"type": "string"},
        "action": {"enum": ["create", "update", "override", "adopt", "restore", "noop", "delete"]},
        "beforeSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "afterSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "owned": {"type": "boolean"},
        "delete": {"type": "boolean"},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}
      },
      "oneOf": [
        {
          "required": ["afterSHA256"],
          "properties": {
            "action": {"enum": ["create", "update", "override", "adopt", "restore", "noop"]},
            "delete": {"const": false}
          }
        },
        {
          "required": ["delete"],
          "properties": {
            "action": {"const": "delete"},
            "delete": {"const": true}
          }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["error", "warning"]},
        "code": {"type": "string"},
        "path": {"type": "string"},
        "message": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "targetPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "metadata", "status"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "agent": {"type": "object", "additionalProperties": false, "required": ["mode", "name"], "properties": {"mode": {"enum": ["primary", "subagent"]}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}},
        "install": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["named-profile", "default-config"]}, "profileName": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "useCommand": {"type": "string"}, "setsDefault": {"type": "boolean"}}},
        "config": {"type": "object", "additionalProperties": false, "required": ["source"], "properties": {"source": {"enum": ["default", "explicit"]}}},
        "metadata": {"$ref": "#/$defs/metadata"},
        "status": {"enum": ["ready", "noop", "blocked", "conflict", "unavailable", "skipped"]},
        "reason": {"type": "string"},
		"destinationSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "versionCheck": {"$ref": "#/$defs/versionCheck"},
        "skippedRequirements": {"type": "array", "items": {"$ref": "#/$defs/skippedRequirement"}}
      }
    },
    "skippedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement"],
      "properties": {
        "requirement": {"enum": ["permissions", "tools", "instructions", "skills", "roles", "role-definitions", "subagentMaxEffort", "effort", "globalInstructions"]},
        "count": {"type": "integer", "minimum": 1},
        "value": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "versionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "qualified", "range", "status"],
      "properties": {
        "binary": {"type": "string"},
        "qualified": {"type": "string"},
        "range": {"type": "string", "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "detected": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["in-range", "out-of-range", "not-found", "unknown"]}
      }
    }
  }
}
